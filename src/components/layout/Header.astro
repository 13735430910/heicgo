---
import type { Locale } from "../../i18n/translations";
import { ALL_LOCALES } from "../../i18n/translations";
import { getTranslation, localeLabels } from "../../i18n/ui";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = getTranslation(locale);

function switchPath(path: string, to: Locale): string {
  const parts = path.split("/").filter(Boolean);
  if (parts.length > 0) {
    const first = parts[0];
    const isLocale = ALL_LOCALES.includes(first as Locale);
    if (isLocale) {
      parts[0] = to;
      return "/" + parts.join("/");
    }
  }
  return "/" + to + (parts.length ? "/" + parts.join("/") : "");
}
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-border">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href={`/${locale}`} class="flex items-center gap-2 font-semibold text-lg no-underline text-text">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <circle cx="8.5" cy="8.5" r="1.5"/>
        <polyline points="21,15 16,10 5,21"/>
      </svg>
      <span>heicgo</span>
    </a>

    <nav class="hidden sm:flex items-center gap-6 text-sm" aria-label="Main navigation">
      <a href={`/${locale}`} class="text-text-secondary hover:text-text transition-colors">{t.nav.home}</a>
      <a href={`/${locale}/blog`} class="text-text-secondary hover:text-text transition-colors">{t.nav.blog}</a>
      <a href={`/${locale}/faq`} class="text-text-secondary hover:text-text transition-colors">{t.nav.faq}</a>
      <a href={`/${locale}/about`} class="text-text-secondary hover:text-text transition-colors">{t.nav.about}</a>
      <a href={`/${locale}/contact`} class="text-text-secondary hover:text-text transition-colors">{t.nav.contact}</a>
    </nav>

    <div class="relative group">
      <button class="text-sm text-text-secondary hover:text-text transition-colors px-2 py-1 rounded border border-border hover:border-text-muted flex items-center gap-1">
        {localeLabels[locale]}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <div class="absolute right-0 top-full mt-1 bg-white border border-border rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 min-w-[120px]">
        {ALL_LOCALES.map((l) => (
          <a
            href={switchPath(currentPath, l)}
            class={`block px-4 py-2 text-sm hover:bg-gray-50 transition-colors ${l === locale ? "font-semibold text-primary" : "text-text-secondary"}`}
          >
            {localeLabels[l]}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>
