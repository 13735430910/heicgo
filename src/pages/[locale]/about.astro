---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";
import { supportContent } from "../../i18n/support-content";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const content = supportContent[locale].about;
const path = Astro.url.pathname;
---

<BaseLayout locale={locale} title={t.seo.aboutTitle} description={t.seo.aboutDescription} path={path} alternateLocales={ALL_LOCALES}>
  <section class="bg-white border-b border-border">
    <div class="max-w-6xl mx-auto px-4 py-12 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-sm font-medium text-primary mb-3">{content.eyebrow}</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-text mb-4">{content.title}</h1>
        <p class="text-lg text-text-secondary leading-relaxed">{content.intro}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {content.differences.map((item) => (
          <article class="bg-bg border border-border rounded-lg p-4">
            <h2 class="font-semibold text-text mb-1">{item.title}</h2>
            <p class="text-sm text-text-secondary leading-relaxed">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
    <div class="prose prose-slate max-w-none prose-headings:text-text prose-p:text-text-secondary">
      <h2>{content.missionTitle}</h2>
      {content.mission.map((p) => <p>{p}</p>)}
    </div>

    <div>
      <h2 class="text-xl font-semibold text-text mb-5">{content.workflowTitle}</h2>
      <ol class="grid gap-4 sm:grid-cols-2">
        {content.workflow.map((step, index) => (
          <li class="flex gap-3">
            <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-primary text-white text-sm font-semibold">{index + 1}</span>
            <div>
              <h3 class="font-semibold text-text">{step.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed mt-1">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-white border-y border-border">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-xl font-semibold text-text mb-5">{content.technologyTitle}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {content.technology.map((item) => (
          <article class="bg-surface border border-border rounded-lg p-4">
            <h3 class="font-semibold text-text mb-1">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-12 text-center">
    <h2 class="text-xl font-semibold text-text mb-3">{content.contactTitle}</h2>
    <p class="text-text-secondary">{content.contactBody}</p>
  </section>
</BaseLayout>
