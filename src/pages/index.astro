---
// Root language router. Browser users land on their locale page; unsupported
// languages fall back to English.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://heicgo.com/en/" />
    <link rel="alternate" hreflang="en" href="https://heicgo.com/en/" />
    <link rel="alternate" hreflang="zh-Hans" href="https://heicgo.com/zh-CN/" />
    <link rel="alternate" hreflang="de" href="https://heicgo.com/de/" />
    <link rel="alternate" hreflang="ja" href="https://heicgo.com/ja/" />
    <link rel="alternate" hreflang="ko" href="https://heicgo.com/ko/" />
    <link rel="alternate" hreflang="fr" href="https://heicgo.com/fr/" />
    <link rel="alternate" hreflang="x-default" href="https://heicgo.com/en/" />
    <title>heicgo — HEIC to JPG or PNG Converter</title>
    <script>
      (function () {
        var supported = {
          en: "/en/",
          "zh-cn": "/zh-CN/",
          zh: "/zh-CN/",
          de: "/de/",
          ja: "/ja/",
          ko: "/ko/",
          fr: "/fr/"
        };

        var saved = "";
        try { saved = localStorage.getItem("heicgo-locale") || ""; } catch {}

        var langs = saved ? [saved] : (navigator.languages || [navigator.language || "en"]);
        var target = "/en/";
        for (var i = 0; i < langs.length; i++) {
          var lang = String(langs[i] || "").toLowerCase();
          if (supported[lang]) {
            target = supported[lang];
            break;
          }
          var base = lang.split("-")[0];
          if (supported[base]) {
            target = supported[base];
            break;
          }
        }

        window.location.replace(target + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">heicgo.com/en/</a>...</p>
  </body>
</html>
