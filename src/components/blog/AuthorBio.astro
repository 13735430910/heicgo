---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<div class="mt-8 pt-6 border-t border-border flex items-start gap-4 not-prose">
  <div class="w-12 h-12 rounded-full bg-primary-light flex items-center justify-center flex-shrink-0">
    <span class="text-primary font-bold text-lg">H</span>
  </div>
  <div>
    <p class="font-semibold text-text text-sm">heicgo Editorial Team</p>
    <p class="text-text-muted text-xs mt-0.5">
      Published <time datetime={date.toISOString()}>
        {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      &nbsp;·&nbsp; Expert guides on HEIC conversion, image formats, and photo management.
    </p>
  </div>
</div>
