---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ALL_LOCALES } from "../i18n/translations";
import { localeLabels } from "../i18n/ui";

const title = "heicgo — Free HEIC to JPG or PNG Converter";
const description = "Choose your language for heicgo, a free private HEIC to JPG or PNG converter that runs in your browser with no upload.";
---

<BaseLayout locale="en" title={title} description={description} path="/" alternateLocales={ALL_LOCALES} xDefaultPath="/">
  <section class="max-w-5xl mx-auto px-4 py-16 sm:py-20 text-center">
    <p class="text-sm font-medium text-primary mb-3">heicgo.com</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-text mb-4">HEIC to JPG or PNG Converter</h1>
    <p class="text-lg text-text-secondary max-w-2xl mx-auto">
      Choose a language to open the private browser-based converter. Your HEIC files stay on your device.
    </p>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-10 text-left">
      {ALL_LOCALES.map((locale) => (
        <a
          href={`/${locale}/`}
          class="block bg-surface border border-border rounded-lg p-4 no-underline hover:border-primary transition-colors"
        >
          <span class="font-semibold text-text">{localeLabels[locale]}</span>
          <span class="block text-sm text-text-secondary mt-1">/{locale}/</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
