---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const path = Astro.url.pathname;
const canonicalPath = locale === "en" ? path : path.replace(`/${locale}/`, "/en/");
const noindex = locale !== "en";
---

<BaseLayout locale={locale} title="Contact — heicgo" description="Get in touch with the heicgo team. We welcome feedback, bug reports, and partnership inquiries." path={path} canonicalPath={canonicalPath} noindex={noindex}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-text mb-4">Contact Us</h1>
    <p class="text-text-secondary mb-8">
      We'd love to hear from you. Whether you have feedback, found a bug,
      or want to discuss a partnership — reach out below.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 mb-12">
      <div class="bg-surface border border-border rounded-lg p-6">
        <div class="text-primary mb-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h2 class="font-semibold text-text mb-1">General Inquiries</h2>
        <a href="mailto:hello@heicgo.com" class="text-primary hover:underline text-sm">hello@heicgo.com</a>
      </div>
      <div class="bg-surface border border-border rounded-lg p-6">
        <div class="text-primary mb-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <h2 class="font-semibold text-text mb-1">Bug Reports</h2>
        <a href="mailto:bugs@heicgo.com" class="text-primary hover:underline text-sm">bugs@heicgo.com</a>
      </div>
      <div class="bg-surface border border-border rounded-lg p-6">
        <div class="text-primary mb-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </div>
        <h2 class="font-semibold text-text mb-1">Partnerships</h2>
        <a href="mailto:partner@heicgo.com" class="text-primary hover:underline text-sm">partner@heicgo.com</a>
      </div>
      <div class="bg-surface border border-border rounded-lg p-6">
        <div class="text-primary mb-3">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h2 class="font-semibold text-text mb-1">Privacy</h2>
        <a href="mailto:privacy@heicgo.com" class="text-primary hover:underline text-sm">privacy@heicgo.com</a>
      </div>
    </div>

    <div class="bg-gray-50 border border-border rounded-lg p-8 text-center">
      <h2 class="text-xl font-semibold text-text mb-3">Response Time</h2>
      <p class="text-text-secondary text-sm max-w-md mx-auto">
        We typically respond within 24-48 hours on business days.
        For urgent issues, please include detailed steps to reproduce the problem.
      </p>
    </div>
  </div>
</BaseLayout>
