---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const path = Astro.url.pathname;
---

<BaseLayout locale={locale} title={t.seo.privacyTitle} description={t.seo.privacyDescription} path={path}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose prose-slate max-w-none prose-headings:text-text prose-p:text-text-secondary">
    <h1>Privacy Policy</h1>
    <p class="text-sm text-text-muted">Last updated: June 3, 2025</p>

    <h2>1. Overview</h2>
    <p>
      heicgo.com ("heicgo", "we", "us", "our") is committed to protecting your privacy.
      This policy explains how we collect, use, and disclose information when you use
      our HEIC to JPG conversion tool and associated services.
    </p>
    <p>
      <strong>All image conversion happens locally in your browser.</strong>
      Your HEIC files, converted JPEGs, and EXIF metadata never leave your device
      and are never transmitted to our servers.
    </p>

    <h2>2. Information We Collect</h2>
    <h3>2.1 Automatically Collected Information</h3>
    <p>When you visit heicgo.com, we automatically collect certain information via third-party services:</p>
    <ul>
      <li><strong>Log Data:</strong> IP address, browser type, referring/exit pages, date/time stamps (collected by Cloudflare CDN for security and performance).</li>
      <li><strong>Analytics:</strong> Anonymous usage data via Cloudflare Web Analytics (does not use cookies or track individuals across sites).</li>
    </ul>
    <h3>2.2 Information We Do NOT Collect</h3>
    <ul>
      <li>HEIC files you upload for conversion</li>
      <li>Converted JPEG files</li>
      <li>EXIF metadata (GPS location, camera info, timestamps)</li>
      <li>File names or contents</li>
      <li>Personal identification information (names, emails, addresses)</li>
    </ul>

    <h2>3. Cookies and Tracking Technologies</h2>
    <p>
      We use cookies and similar tracking technologies to enhance your experience
      and serve advertisements.
    </p>
    <h3>3.1 Google AdSense & Advertising Cookies</h3>
    <p>
      We use Google AdSense to display advertisements on heicgo.com. Google uses
      cookies, including the <strong>DoubleClick cookie</strong>, to serve ads
      based on your prior visits to our site and other websites on the internet.
    </p>
    <p>
      Google's use of advertising cookies enables it and its partners to serve ads
      to you based on your visit to our site and/or other sites on the Internet.
      These cookies collect information about your browsing behavior to show you
      relevant advertisements.
    </p>
    <p><strong>Your choices regarding Google advertising cookies:</strong></p>
    <ul>
      <li>You may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads">Google Ads Settings</a>.</li>
      <li>You may opt out of third-party vendor cookies by visiting <a href="https://www.aboutads.info/choices/">aboutads.info</a> or <a href="https://www.youronlinechoices.com/">youronlinechoices.com</a>.</li>
      <li>You can configure your browser to block or alert you about cookies. Note that blocking cookies may affect site functionality.</li>
    </ul>
    <p>
      European users: Under GDPR, we obtain consent before setting non-essential
      cookies where required. You may withdraw consent at any time.
    </p>

    <h3>3.2 Essential Cookies</h3>
    <p>
      We use a minimal cookie to remember your language preference (locale selection).
      This cookie is strictly necessary for site functionality and does not
      track you across sites.
    </p>

    <h3>3.3 Web Analytics (Privacy-First)</h3>
    <p>
      We use Cloudflare Web Analytics, which is a privacy-first analytics solution
      that <strong>does not use cookies</strong>, does not track individuals across
      sites, and does not collect personally identifiable information.
    </p>

    <h2>4. How We Use Information</h2>
    <p>The limited information we collect is used for:</p>
    <ul>
      <li>Displaying relevant advertisements via Google AdSense</li>
      <li>Monitoring site performance and availability (Cloudflare CDN)</li>
      <li>Understanding aggregate usage patterns to improve the service</li>
      <li>Preventing abuse and ensuring security</li>
    </ul>

    <h2>5. Third-Party Services</h2>
    <p>We use the following third-party services that may process data:</p>
    <table class="w-full text-sm border-collapse">
      <thead><tr class="border-b border-border"><th class="text-left py-2 pr-4">Service</th><th class="text-left py-2 pr-4">Purpose</th><th class="text-left py-2">Privacy Policy</th></tr></thead>
      <tbody>
        <tr class="border-b border-border"><td class="py-2 pr-4">Google AdSense</td><td class="py-2 pr-4">Display advertising</td><td class="py-2"><a href="https://policies.google.com/privacy">Google Privacy Policy</a></td></tr>
        <tr class="border-b border-border"><td class="py-2 pr-4">Cloudflare</td><td class="py-2 pr-4">CDN, security, DNS</td><td class="py-2"><a href="https://www.cloudflare.com/privacypolicy/">Cloudflare Privacy Policy</a></td></tr>
      </tbody>
    </table>

    <h2>6. Data Security</h2>
    <p>
      Since all image processing occurs client-side, there is no server-side storage
      or transmission of your files. The site is served exclusively over HTTPS via
      Cloudflare's global CDN, encrypting all data in transit.
    </p>

    <h2>7. Children's Privacy</h2>
    <p>
      heicgo.com is not directed at children under 13. We do not knowingly collect
      personal information from children. If you believe a child has provided
      personal information, please contact us.
    </p>

    <h2>8. Your Rights (GDPR / CCPA)</h2>
    <p>Depending on your jurisdiction, you may have the right to:</p>
    <ul>
      <li>Access the personal data we hold about you</li>
      <li>Request correction or deletion of your data</li>
      <li>Object to or restrict processing of your data</li>
      <li>Data portability</li>
      <li>Withdraw consent at any time</li>
    </ul>
    <p>To exercise these rights, contact us at <a href="mailto:privacy@heicgo.com">privacy@heicgo.com</a>.</p>

    <h2>9. Changes to This Policy</h2>
    <p>
      We may update this Privacy Policy from time to time. We will notify you of
      any changes by posting the new Privacy Policy on this page. Changes are
      effective immediately upon posting.
    </p>

    <h2>10. Contact Us</h2>
    <p>
      For questions about this Privacy Policy, contact:
      <br/>Email: <a href="mailto:privacy@heicgo.com">privacy@heicgo.com</a>
      <br/>Website: <a href="/en/contact">heicgo.com/en/contact</a>
    </p>
  </div>
</BaseLayout>
