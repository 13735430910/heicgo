---
import type { Locale } from "../i18n/translations";
import SEO from "../components/layout/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { ADSENSE } from "../config";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  alternateLocales?: Locale[];
  xDefaultPath?: string;
  noindex?: boolean;
  type?: "website" | "article";
  image?: string;
}

const {
  locale,
  title,
  description,
  path,
  canonicalPath,
  alternateLocales = [locale],
  xDefaultPath,
  noindex = false,
  type,
  image,
} = Astro.props;
const localeBCP = locale === "zh-CN" ? "zh-Hans" : locale;
const strippedPath = (canonicalPath ?? path).replace(/^\/(en|zh-CN|de|ja|ko|fr)/, "") || "/";
const xDefaultHref = xDefaultPath
  ? new URL(xDefaultPath, Astro.site).href
  : new URL("/en" + strippedPath, Astro.site).href;
---

<!doctype html>
<html lang={localeBCP}>
  <head>
    <meta charset="utf-8" />
    <!-- Preconnect to third-party origins for faster ad + analytics loading -->
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <SEO {title} {description} {locale} {path} {canonicalPath} {type} {image} {noindex} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternateLocales.map((l) => {
      const altBCP = l === "zh-CN" ? "zh-Hans" : l;
      return <link rel="alternate" hreflang={altBCP} href={new URL("/" + l + strippedPath, Astro.site).href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Google AdSense Auto Ads -->
    {!ADSENSE.publisherId.includes("XXXX") && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.publisherId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "heicgo_analytics"}`}></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header {locale} currentPath={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer {locale} />
  </body>
</html>
