---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromParams } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";
import { supportContent } from "../../i18n/support-content";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const content = supportContent[locale].contact;
const path = Astro.url.pathname;
---

<BaseLayout locale={locale} title={`${content.title} — heicgo`} description={content.description} path={path} alternateLocales={ALL_LOCALES}>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-text mb-4">{content.title}</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">{content.description}</p>

    <div class="grid gap-6 sm:grid-cols-2 mb-12">
      {content.cards.map((card) => (
        <article class="bg-surface border border-border rounded-lg p-6">
          <div class="text-primary mb-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h2 class="font-semibold text-text mb-1">{card.title}</h2>
          <p class="text-sm text-text-secondary mb-3 leading-relaxed">{card.body}</p>
          <a href={`mailto:${card.email}`} class="text-primary hover:underline text-sm">{card.email}</a>
        </article>
      ))}
    </div>

    <div class="bg-white border border-border rounded-lg p-8">
      <h2 class="text-xl font-semibold text-text mb-3">{content.responseTitle}</h2>
      <p class="text-text-secondary text-sm max-w-2xl leading-relaxed">{content.responseBody}</p>
    </div>
  </div>
</BaseLayout>
