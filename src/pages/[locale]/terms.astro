---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const path = Astro.url.pathname;
---

<BaseLayout locale={locale} title={t.seo.termsTitle} description={t.seo.termsDescription} path={path}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose prose-slate max-w-none prose-headings:text-text prose-p:text-text-secondary">
    <h1>Terms of Service</h1>
    <p class="text-sm text-text-muted">Last updated: June 3, 2025</p>

    <h2>1. Acceptance</h2>
    <p>By using heicgo.com, you agree to these terms.</p>

    <h2>2. Service Description</h2>
    <p>heicgo.com provides a free online HEIC to JPEG conversion tool. All processing occurs locally in your browser.</p>

    <h2>3. User Responsibilities</h2>
    <ul>
      <li>You are responsible for the files you convert.</li>
      <li>Do not use the service for illegal content.</li>
      <li>You retain all rights to your images.</li>
    </ul>

    <h2>4. Disclaimer</h2>
    <p>The service is provided "as is" without warranties. We are not liable for damages arising from use of the service.</p>

    <h2>5. Changes</h2>
    <p>We may update these terms. Continued use constitutes acceptance.</p>
  </div>
</BaseLayout>
