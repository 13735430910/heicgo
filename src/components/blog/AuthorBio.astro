---
import type { Locale } from "../../i18n/translations";
import { blogUi } from "../../i18n/localized-blog";

interface Props {
  date: Date;
  locale: Locale;
}

const { date, locale } = Astro.props;
const ui = blogUi[locale];
const dateLocaleMap = { en: "en-US", "zh-CN": "zh-CN", de: "de-DE", ja: "ja-JP", ko: "ko-KR", fr: "fr-FR" };
---

<div class="mt-8 pt-6 border-t border-border flex items-start gap-4 not-prose">
  <div class="w-12 h-12 rounded-full bg-primary-light flex items-center justify-center flex-shrink-0">
    <span class="text-primary font-bold text-lg">H</span>
  </div>
  <div>
    <p class="font-semibold text-text text-sm">{ui.author}</p>
    <p class="text-text-muted text-xs mt-0.5">
      {ui.published} <time datetime={date.toISOString()}>
        {date.toLocaleDateString(dateLocaleMap[locale], { year: "numeric", month: "long", day: "numeric" })}
      </time>
      &nbsp;·&nbsp; {ui.authorNote}
    </p>
  </div>
</div>
