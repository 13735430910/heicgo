---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AdBanner from "../../../../components/ads/AdBanner.astro";
import AuthorBio from "../../../../components/blog/AuthorBio.astro";
import RelatedPosts from "../../../../components/blog/RelatedPosts.astro";
import { getLocaleFromParams } from "../../../../i18n/ui";
import { FULL_LOCALES } from "../../../../i18n/translations";
import { blogUi, getLocalizedBlogArticle, getLocalizedBlogMeta, localizedTags } from "../../../../i18n/localized-blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const post of posts) {
    for (const locale of FULL_LOCALES) {
      paths.push({ params: { locale, postSlug: post.id }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const { Content } = await render(post);
const locale = getLocaleFromParams(Astro.params);
const ui = blogUi[locale];
const path = Astro.url.pathname;

const meta = getLocalizedBlogMeta(locale, post);
const localizedArticle = getLocalizedBlogArticle(locale, post);
const displayTitle = meta.title;
const displayDesc = meta.description;

// Load all posts for related posts calculation
const allPosts = await getCollection("blog");

// Article structured data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: displayTitle,
  description: displayDesc,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
  author: { "@type": "Organization", name: ui.author, url: new URL(`/${locale}/about`, Astro.site).href },
  publisher: { "@type": "Organization", name: "heicgo", url: "https://heicgo.com" },
  mainEntityOfPage: { "@type": "WebPage", "@id": new URL(path, Astro.site).href },
};

// Breadcrumb structured data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: ui.home, item: `${Astro.site}${locale}/` },
    { "@type": "ListItem", position: 2, name: ui.blog, item: `${Astro.site}${locale}/blog/` },
    { "@type": "ListItem", position: 3, name: displayTitle },
  ],
};

const dateLocaleMap = { en: "en-US", "zh-CN": "zh-CN", de: "de-DE", ja: "ja-JP", ko: "ko-KR", fr: "fr-FR" };
const dateLocale = dateLocaleMap[locale];
const dateOpts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
const tagLabels = localizedTags(locale, post.data.tags ?? []);
---

<BaseLayout locale={locale} title={displayTitle} description={displayDesc} path={path} alternateLocales={FULL_LOCALES} type="article">
  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-6" aria-label="Breadcrumb">
      <a href={`/${locale}`} class="hover:text-text transition-colors">{ui.home}</a>
      <span>/</span>
      <a href={`/${locale}/blog`} class="hover:text-text transition-colors">{ui.blog}</a>
      <span>/</span>
      <span class="text-text">{displayTitle}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-text mb-4">{displayTitle}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted">
        <time datetime={post.data.publishDate.toISOString()}>
          {post.data.publishDate.toLocaleDateString(dateLocale, dateOpts)}
        </time>
        {tagLabels.map((tag) => (
          <span class="bg-gray-100 px-2 py-0.5 rounded text-xs">{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose prose-slate max-w-none max-w-3xl prose-headings:text-text prose-p:text-text-secondary prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm">
      {locale === "en" ? (
        <Content />
      ) : localizedArticle && (
        <>
          {localizedArticle.intro.map((p) => <p>{p}</p>)}
          {localizedArticle.sections.map((section) => (
            <section>
              <h2>{section.title}</h2>
              {section.paragraphs?.map((p) => <p>{p}</p>)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))}
        </>
      )}
    </div>

    <AuthorBio date={post.data.publishDate} locale={locale} />

    <!-- Related Posts (internal linking for SEO) -->
    <RelatedPosts current={post} allPosts={allPosts} locale={locale} />
  </article>

  <AdBanner locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
