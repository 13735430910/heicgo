---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdBanner from "../../components/ads/AdBanner.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const path = Astro.url.pathname;

const faqs = [
  {
    q: "Is heicgo really free?",
    a: "Yes, heicgo is completely free with no limits on file count or conversions. The site is supported by advertisements.",
  },
  {
    q: "Are my photos uploaded to a server?",
    a: "No. All HEIC to JPG conversion happens locally in your browser. Your files never leave your device.",
  },
  {
    q: "Does the conversion preserve EXIF metadata?",
    a: "Yes! heicgo preserves EXIF data including GPS location, date/time, and camera model — this is our key differentiator.",
  },
  {
    q: "What is the maximum file size?",
    a: "Each file can be up to 50MB.",
  },
  {
    q: "Which browsers are supported?",
    a: "Safari 17+ (fastest), Chrome, Firefox, and Edge all work.",
  },
  {
    q: "Can I batch convert multiple files?",
    a: "Yes. Drag in multiple files and use 'Download All (ZIP)' to get them in a single archive.",
  },
  {
    q: "What quality setting should I use?",
    a: "Default 92% is a good balance. Use 100% for best quality or 60-80% for smaller files.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<BaseLayout locale={locale} title={t.seo.faqTitle} description={t.seo.faqDescription} path={path}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-text mb-8">Frequently Asked Questions</h1>
    <div class="space-y-6">
      {faqs.map((faq) => (
        <div class="bg-surface border border-border rounded-lg p-5">
          <h2 class="font-semibold text-text mb-2">{faq.q}</h2>
          <p class="text-text-secondary text-sm leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
  <AdBanner />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
