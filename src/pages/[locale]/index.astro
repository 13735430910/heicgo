---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdBanner from "../../components/ads/AdBanner.astro";
import { Converter } from "../../components/converter/Converter";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";
import { homeContent } from "../../i18n/home-content";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const content = homeContent[locale];
const path = Astro.url.pathname;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t.hero.title,
  description: t.seo.homeDescription,
  totalTime: "PT30S",
  tool: [
    { "@type": "HowToTool", name: "Web browser (Chrome, Safari, Firefox, or Edge)" },
  ],
  step: content.steps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.title,
      text: step.body,
  })),
};
---

<BaseLayout locale={locale} title={t.seo.homeTitle} description={t.seo.homeDescription} path={path} alternateLocales={ALL_LOCALES} xDefaultPath="/">
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-5 text-center">
    <p class="text-sm font-medium text-primary mb-3">heicgo.com</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-text mb-3">{t.hero.title}</h1>
    <p class="text-lg text-text-secondary max-w-2xl mx-auto">{t.hero.subtitle}</p>
  </section>

  <AdBanner />

  <section class="max-w-4xl mx-auto px-4 pb-10">
    <Converter texts={t} client:load />
  </section>

  <AdBanner />

  <section class="bg-white border-y border-border">
    <div class="max-w-6xl mx-auto px-4 py-12 grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="prose prose-slate max-w-none prose-headings:text-text prose-p:text-text-secondary prose-a:text-primary">
        <h2>{content.introTitle}</h2>
        {content.intro.map((p) => <p>{p}</p>)}
      </div>
      <div>
        <h2 class="text-xl font-semibold text-text mb-4">{content.benefitsTitle}</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {content.benefits.map((item) => (
            <article class="bg-bg border border-border rounded-lg p-4">
              <h3 class="font-semibold text-text mb-1">{item.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 grid gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-xl font-semibold text-text mb-5">{content.workflowTitle}</h2>
      <ol class="space-y-4">
        {content.steps.map((step, index) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-primary text-white text-sm font-semibold">{index + 1}</span>
            <div>
              <h3 class="font-semibold text-text">{step.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed mt-1">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-text mb-5">{content.useCasesTitle}</h2>
      <ul class="space-y-3">
        {content.useCases.map((item) => (
          <li class="flex gap-3 text-sm text-text-secondary leading-relaxed">
            <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-primary"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-white border-t border-border">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-xl font-semibold text-text mb-6">{content.faqTitle}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {content.faqs.map((faq) => (
          <article class="border border-border rounded-lg p-4 bg-surface">
            <h3 class="font-semibold text-text mb-2">{faq.q}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{faq.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
</BaseLayout>
