---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdBanner from "../../components/ads/AdBanner.astro";
import { getLocaleFromParams, getTranslation } from "../../i18n/ui";
import { ALL_LOCALES } from "../../i18n/translations";
import { supportContent } from "../../i18n/support-content";

export function getStaticPaths() {
  return ALL_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = getTranslation(locale);
const content = supportContent[locale].faq;
const path = Astro.url.pathname;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.items.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<BaseLayout locale={locale} title={t.seo.faqTitle} description={content.description} path={path} alternateLocales={ALL_LOCALES}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-text mb-3">{content.title}</h1>
    <p class="text-text-secondary mb-8 max-w-2xl">{content.description}</p>
    <div class="grid gap-5 sm:grid-cols-2">
      {content.items.map((faq) => (
        <article class="bg-surface border border-border rounded-lg p-5">
          <h2 class="font-semibold text-text mb-2">{faq.q}</h2>
          <p class="text-text-secondary text-sm leading-relaxed">{faq.a}</p>
        </article>
      ))}
    </div>
  </div>
  <AdBanner locale={locale} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
