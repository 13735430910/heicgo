---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  title="Page Not Found — heicgo"
  description="The page you're looking for doesn't exist."
  path="/404"
>
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-text-muted mb-4">404</h1>
    <h2 class="text-xl font-semibold text-text mb-2">Page Not Found</h2>
    <p class="text-text-secondary mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <div class="flex gap-4 justify-center">
      <a href="/en/" class="bg-primary text-white px-6 py-2.5 rounded-lg font-medium hover:bg-primary-dark transition-colors">Go to Homepage</a>
      <a href="/en/blog/" class="border border-border text-text-secondary px-6 py-2.5 rounded-lg font-medium hover:bg-gray-50 transition-colors">Visit Blog</a>
    </div>
  </div>
</BaseLayout>
