---
// Root redirect: detect browser language and redirect
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>heicgo — HEIC to JPG Converter</title>
    <script>
      (function() {
        var lang = (navigator.language || '').toLowerCase();
        var target;
        if (lang.startsWith('zh')) target = '/zh-CN/';
        else if (lang.startsWith('de')) target = '/de/';
        else if (lang.startsWith('ja')) target = '/ja/';
        else if (lang.startsWith('ko')) target = '/ko/';
        else if (lang.startsWith('fr')) target = '/fr/';
        else target = '/en/';
        window.location.replace(target + window.location.search + window.location.hash);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">heicgo.com/en/</a>...</p>
  </body>
</html>
